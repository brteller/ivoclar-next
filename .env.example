# Required for page data API (build-page-speed)
API_KEY_SECRET=your_api_key_here

# Google reCAPTCHA v3 keys for spam protection on the lead-capture form.
# Create a v3 site at https://www.google.com/recaptcha/admin/create
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY is exposed to the browser; RECAPTCHA_SECRET_KEY must stay server-side.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here
# Optional: minimum reCAPTCHA v3 score (0.0-1.0) required to accept a submission. Default 0.5.
# RECAPTCHA_MIN_SCORE=0.5
# Optional: expected action name configured on the form (must match the action used client-side). Default lead_capture.
# RECAPTCHA_EXPECTED_ACTION=lead_capture

# Pardot form handler URL. /api/contact forwards form submissions here as
# application/x-www-form-urlencoded after reCAPTCHA verification succeeds.
# Defaults to the production Pardot endpoint if unset.
# PARDOT_FORM_ACTION=https://campaign.ivoclar.com/l/794073/2025-04-07/489ns7

# Optional: additional JSON webhooks /api/contact forwards to after reCAPTCHA passes.
# CONTACT_WEBHOOK_URL=https://your-backend.com/contact
# SALESFORCE_WEBHOOK_URL=https://your-salesforce-webhook.example.com
